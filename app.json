{
  "expo": {
    "name": "ShareKita",
    "slug": "sharekita-nearby-transfer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sharekita.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ShareKita uses camera access to scan nearby transfer pairing QR codes.",
        "NSLocalNetworkUsageDescription": "ShareKita connects directly to a nearby phone on the same hotspot to transfer files. Nothing is uploaded.",
        "NSPhotoLibraryUsageDescription": "ShareKita requires photo library access to send and save received media files.",
        "NSPhotoLibraryAddUsageDescription": "ShareKita saves received photos and videos to your photo library.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD21F"
      },
      "package": "com.sharekita.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "ACCESS_LOCAL_NETWORK",
        "CHANGE_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "NEARBY_WIFI_DEVICES",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ShareKita uses the camera to scan pairing QR codes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#F8FAFC",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "sharekita",
    "extra": {
      "eas": {
        "projectId": "c3445ea3-67f5-4013-898e-2e7c0229cf5e"
      }
    },
    "owner": "ciaocel"
  }
}